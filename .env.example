# Incident Copilot Configuration
# Copy to .env and fill in your values

# App
DEBUG=false

# PagerDuty
PAGERDUTY_API_KEY=your-pagerduty-api-key
PAGERDUTY_WEBHOOK_SECRET=your-webhook-signing-secret

# On-Call Roster (uses PagerDuty or Opsgenie credentials)
ONCALL_PROVIDER=auto  # auto | pagerduty | opsgenie
ONCALL_ENABLED=true
ONCALL_SCHEDULE_ID=YOUR_DEFAULT_SCHEDULE_ID
# Service to schedule mapping: ONCALL_SCHEDULE_MAP='{"payments-api": "SCHEDULE123", "auth-service": "SCHEDULE456"}'

# GitHub
GITHUB_TOKEN=ghp_your-personal-access-token
GITHUB_ORG=your-github-org

# GitLab (alternative to GitHub - configure one or the other)
GITLAB_TOKEN=glpat-your-gitlab-token
GITLAB_URL=https://gitlab.com
# Project mappings: GITLAB_PROJECT_MAP='{"service-name": "group/subgroup/project"}'

# Log Provider (datadog | cloudwatch)
LOG_PROVIDER=datadog

# Datadog
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key
DATADOG_SITE=datadoghq.com

# AWS CloudWatch (alternative to Datadog)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Log group mappings: CLOUDWATCH_LOG_GROUP_MAP='{"service-name": "/aws/lambda/service-name"}'

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_DEFAULT_CHANNEL=#incidents

# AI (Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
AI_MODEL=claude-3-haiku-20240307

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-your-openai-key

# Similarity Search
SIMILARITY_DB_PATH=data/incidents.db

# Database (for future use)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/incident_copilot
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ENCRYPTION_KEY=
APP_URL=http://localhost:8000

# OAuth - GitHub (https://github.com/settings/developers)
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret

# OAuth - Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# OAuth - Integration providers
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
PAGERDUTY_CLIENT_ID=your-pagerduty-client-id
PAGERDUTY_CLIENT_SECRET=your-pagerduty-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITLAB_CLIENT_ID=your-gitlab-client-id
GITLAB_CLIENT_SECRET=your-gitlab-client-secret
ATLASSIAN_CLIENT_ID=your-atlassian-client-id
ATLASSIAN_CLIENT_SECRET=your-atlassian-client-secret

# Supabase (https://supabase.com/dashboard)
# Get these from Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Enable Supabase features (set to true when configured)
SUPABASE_AUTH_ENABLED=false
SUPABASE_DB_ENABLED=false

# Linear (https://linear.app/settings/api)
LINEAR_API_KEY=lin_api_your-linear-api-key
LINEAR_TEAM_ID=your-team-uuid
# LINEAR_LABEL_IDS='["label-uuid-1","label-uuid-2"]'

# Stripe Billing (https://dashboard.stripe.com/apikeys)
STRIPE_API_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRICE_STARTER=price_xxx  # Create in Stripe Dashboard
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx

# Email Settings (for scheduled reports)
EMAIL_PROVIDER=smtp  # smtp | ses (AWS SES)

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Incident Copilot

# AWS SES (alternative to SMTP)
SES_REGION=us-east-1
SES_FROM_EMAIL=noreply@example.com

# Scheduled Reports
REPORTS_ENABLED=true
REPORTS_DEFAULT_TIMEZONE=UTC
REPORTS_AI_INSIGHTS_ENABLED=true

# Runbook Sources
# JSON array of source configurations. Each source needs:
#   - type: "github" | "notion" | "confluence" | "local"
#   - name: A friendly name for the source
#
# GitHub example:
#   {"type": "github", "name": "main-docs", "repo": "org/docs", "paths": ["runbooks/"]}
#
# Notion example:
#   {"type": "notion", "name": "notion-runbooks", "notion_token": "secret_xxx", "notion_database_id": "xxx"}
#
# Confluence example:
#   {"type": "confluence", "name": "confluence", "confluence_url": "https://company.atlassian.net/wiki", "confluence_space": "OPS"}
#
# Local example:
#   {"type": "local", "name": "local-docs", "local_path": "./docs/runbooks", "base_url": "https://docs.example.com"}
#
RUNBOOK_SOURCES='[{"type": "github", "name": "main-docs", "repo": "your-org/runbooks", "paths": ["docs/runbooks"]}]'

# AI Service (proprietary) - leave empty for stub mode
AI_SERVICE_URL=
AI_SERVICE_SECRET=

# Incident Copilot Configuration
# Copy to .env and fill in your values

# App
DEBUG=false

# PagerDuty
PAGERDUTY_API_KEY=your-pagerduty-api-key
PAGERDUTY_WEBHOOK_SECRET=your-webhook-signing-secret

# GitHub
GITHUB_TOKEN=ghp_your-personal-access-token
GITHUB_ORG=your-github-org

# Log Provider (datadog | cloudwatch)
LOG_PROVIDER=datadog

# Datadog
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key
DATADOG_SITE=datadoghq.com

# AWS CloudWatch (alternative to Datadog)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Log group mappings: CLOUDWATCH_LOG_GROUP_MAP='{"service-name": "/aws/lambda/service-name"}'

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_DEFAULT_CHANNEL=#incidents

# AI (Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
AI_MODEL=claude-3-haiku-20240307

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-your-openai-key

# Similarity Search
SIMILARITY_DB_PATH=data/incidents.db

# Database (for future use)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/incident_copilot
REDIS_URL=redis://localhost:6379/0

# Runbook Sources
# JSON array of source configurations. Each source needs:
#   - type: "github" | "notion" | "confluence" | "local"
#   - name: A friendly name for the source
#
# GitHub example:
#   {"type": "github", "name": "main-docs", "repo": "org/docs", "paths": ["runbooks/"]}
#
# Notion example:
#   {"type": "notion", "name": "notion-runbooks", "notion_token": "secret_xxx", "notion_database_id": "xxx"}
#
# Confluence example:
#   {"type": "confluence", "name": "confluence", "confluence_url": "https://company.atlassian.net/wiki", "confluence_space": "OPS"}
#
# Local example:
#   {"type": "local", "name": "local-docs", "local_path": "./docs/runbooks", "base_url": "https://docs.example.com"}
#
RUNBOOK_SOURCES='[{"type": "github", "name": "main-docs", "repo": "your-org/runbooks", "paths": ["docs/runbooks"]}]'
